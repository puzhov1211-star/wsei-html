:root {
  --bg: #0b0b12;
  --panel: #141420;
  --panel-2: #191927;
  --line: rgba(255,255,255,.1);
  --text: #f4f1eb;
  --muted: #aaa4b5;
  --soft: #777286;
  --accent: #ff3b6b;
  --accent-2: #ff8c42;
  --gold: #f4c95d;
  --radius: 18px;
  --shadow: 0 22px 60px rgba(0,0,0,.35);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top, rgba(255,59,107,.15), transparent 38%),
    linear-gradient(180deg, #090911 0%, #0d0d15 100%);
  color: var(--text);
  line-height: 1.6;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
.wrapper { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }

.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(10,10,18,.9);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(12px);
}
.header__row { min-height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.logo { font-weight: 800; letter-spacing: .06em; font-size: 24px; }
.logo span { color: var(--accent); }
.nav { display: flex; align-items: center; gap: 22px; color: var(--muted); font-size: 14px; }
.nav a:hover, .nav a.active { color: var(--text); }
.cart-link {
  background: var(--accent);
  padding: 10px 16px;
  border-radius: 999px;
  color: white !important;
  font-weight: 700;
}

.hero { padding: 92px 0 60px; text-align: center; }
.kicker { color: var(--accent); text-transform: uppercase; letter-spacing: .14em; font-size: 12px; font-weight: 700; }
h1, h2, h3 { line-height: 1.1; margin: 0; }
h1 { font-size: clamp(42px, 8vw, 92px); margin-top: 12px; letter-spacing: .03em; }
h1 span { color: transparent; -webkit-text-stroke: 1px rgba(244,241,235,.45); }
.hero p { color: var(--muted); max-width: 620px; margin: 22px auto 32px; }

.search-box {
  display: flex;
  max-width: 620px;
  margin: 0 auto 20px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 999px;
  overflow: hidden;
}
.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--text);
  padding: 16px 20px;
  outline: none;
}
.search-box button, .button {
  border: 0;
  background: var(--accent);
  color: white;
  font-weight: 700;
  padding: 12px 22px;
  border-radius: 999px;
  margin: 6px;
  cursor: pointer;
  display: inline-block;
}
.button--ghost { background: transparent; border: 1px solid var(--line); color: var(--text); }
.button--small { padding: 8px 14px; margin: 0; font-size: 13px; }
.button:hover { filter: brightness(1.08); transform: translateY(-1px); }

.tags { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.tag { border: 1px solid var(--line); border-radius: 999px; color: var(--muted); padding: 7px 13px; font-size: 13px; }
.tag:hover, .tag.active { color: var(--accent); border-color: rgba(255,59,107,.55); background: rgba(255,59,107,.08); }

.section { padding: 48px 0; }
.section-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 24px; }
.section h2 { font-size: clamp(28px, 4vw, 44px); }
.muted { color: var(--muted); }

.featured {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: var(--panel);
  box-shadow: var(--shadow);
}
.poster {
  min-height: 320px;
  display: grid;
  place-items: center;
  font-size: 90px;
  background: linear-gradient(135deg, #21081a, #14143a);
  position: relative;
}
.poster:after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(20,20,32,.9)); }
.featured__body { padding: 42px; }
.meta { display: flex; flex-wrap: wrap; gap: 12px 22px; color: var(--muted); font-size: 14px; margin: 20px 0; }
.price { font-size: 30px; color: var(--gold); font-weight: 800; }
.actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 24px; }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  transition: .2s ease;
}
.card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.2); }
.card__top { height: 160px; display: grid; place-items: center; font-size: 56px; background: linear-gradient(135deg, #171727, #2b1220); }
.card__body { padding: 18px; }
.card h3 { font-size: 24px; margin: 4px 0; }
.card__foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 16px 18px; border-top: 1px solid var(--line); }
.city-grid { grid-template-columns: repeat(4, 1fr); }
.city-tile { padding: 26px; min-height: 120px; display: flex; flex-direction: column; justify-content: space-between; }

.page-title { padding: 52px 0 20px; }
.page-title h1 { font-size: clamp(34px, 6vw, 64px); }
.breadcrumbs { color: var(--soft); font-size: 13px; margin-bottom: 14px; }
.two-col { display: grid; grid-template-columns: 1fr .75fr; gap: 24px; align-items: start; }
.box { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
.info-list { display: grid; gap: 12px; margin: 20px 0; }
.info-list div { border-bottom: 1px solid var(--line); padding-bottom: 10px; color: var(--muted); }
.info-list strong { color: var(--text); display: inline-block; min-width: 90px; }

.cart-row { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: center; border-bottom: 1px solid var(--line); padding: 18px 0; }
.qty { display: flex; align-items: center; gap: 10px; }
.qty a { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: var(--panel-2); }
.qty strong { min-width: 24px; text-align: center; }
.form { display: grid; gap: 14px; }
.form label { font-size: 13px; color: var(--muted); }
.form input, .form select, .form textarea {
  width: 100%;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 13px 14px;
  color: var(--text);
  font-family: inherit;
}
.form textarea { min-height: 120px; resize: vertical; }
.note { background: rgba(255,59,107,.08); border: 1px solid rgba(255,59,107,.25); color: #ffd4df; padding: 14px 16px; border-radius: 14px; }

.footer { margin-top: 60px; border-top: 1px solid var(--line); padding: 38px 0 24px; color: var(--muted); }
.footer__grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 24px; }
.footer h4 { color: var(--text); margin: 0 0 12px; }
.footer a { display: block; margin: 7px 0; }
.footer a:hover { color: var(--text); }
.copy { border-top: 1px solid var(--line); margin-top: 24px; padding-top: 18px; font-size: 13px; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; }

@media (max-width: 850px) {
  .header__row { flex-wrap: wrap; padding: 14px 0; }
  .nav { width: 100%; overflow-x: auto; padding-bottom: 4px; }
  .hero { padding-top: 58px; }
  .featured, .two-col { grid-template-columns: 1fr; }
  .grid, .city-grid { grid-template-columns: repeat(2, 1fr); }
  .featured__body { padding: 26px; }
  .poster { min-height: 220px; }
  .footer__grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px) {
  .wrapper { width: min(100% - 22px, 1120px); }
  .search-box { border-radius: 18px; flex-direction: column; }
  .search-box button { width: calc(100% - 12px); }
  .grid, .city-grid { grid-template-columns: 1fr; }
  .section-head { align-items: start; flex-direction: column; }
  .cart-row { grid-template-columns: 1fr; }
  .footer__grid { grid-template-columns: 1fr; }
}
